+    // cấp thưởng mốc trả phí qua mail (tra theo payID), không mở UI;
+    // chỉ mở khoá Index khi người chơi đang kẹt đúng ở cổng trả phí này
+    public static bool GrantFromMail(IAP_Product _product, out bool _isUnlockGate, out string _failReason)
+    {
+        _isUnlockGate = false;
+        _failReason = string.Empty;
+        var _payId = _product.ToString();
+        var _idx = -1;
+        for (var i = 0; i < EventOperationHuntData.Count; i++)
+        {
+            if (EventOperationHuntData.GetConfigByIndex(i).payID != _payId) continue;
+            _idx = i;
+            break;
+        }
+        if (_idx < 0)
+        {
+            _failReason = "khong tim thay moc co payID nay";
+            return false;
+        }
+
+        var _process = Player.OperationHuntEventProcess;
+        if (_process != null && _process.Index >= _idx)
+        {
+            _failReason = $"da nhan moc {_idx} roi (index {_process.Index})";
+            return false;
+        }
+
+        var _cfg = EventOperationHuntData.GetConfigByIndex(_idx);
+        Rewards.AddReward(_cfg.rewards, _whereLogReport: AnalyticsWhere.EventOperationHuntClaimNext);
+
+        if (_process != null && _process.Index == _idx - 1)
+        {
+            _process.Index = _idx;
+            SaveData(_process);
+            _isUnlockGate = true;
+        }
+        return true;
+    }
+
 
